    "@lucide/svelte": "^1.73.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "bits-ui": "^2.21.0",
    "harmonyos-sans-sc-webfont-splitted": "1.1.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
