# Potato Cup QQ bots. Copy to apps/bot/.env (scripts/bot-setup.sh does it).
# A bot starts only when its section is filled in; leave a section empty to
# run the other bot alone.

# Website API the bots call (same server).
SITE_API_URL=http://127.0.0.1:3100
# Same value as BOT_TOKEN in apps/api/.env: opens the site's bot routes
# (group notices, bindings, schedules). Empty: only 状态 works.
BOT_TOKEN=

# ---- Official QQ bot (QQ 开放平台 q.qq.com -> 开发设置) ----
# The server's public IP must be in the platform's IP whitelist.
QQ_APP_ID=
QQ_APP_SECRET=
# Bots made in the new console have no sandbox: leave false.
QQ_SANDBOX=false

# ---- Community bot (NapCat, OneBot v11 forward WebSocket) ----
# QQ number of the account logged in to NapCat.
ONEBOT_SELF_ID=
# Same token as in /home/admin/napcat/data/config/onebot11.json (bot-setup.sh fills both).
ONEBOT_TOKEN=
ONEBOT_ENDPOINT=ws://127.0.0.1:3001
# Group numbers the community bot may speak in, comma separated.
ONEBOT_GROUPS=
# Group the match notices go to (default: the first of ONEBOT_GROUPS).
ONEBOT_NOTICE_GROUP=
