PORT=3100
ALLOWED_QQ_GROUPS=460309159,1002072430
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 管理员令牌：破坏性接口要求请求头 x-admin-token 与此值一致。
# 留空则管理员功能关闭（所有破坏性接口返回 503）。
ADMIN_TOKEN=

# Elasticsearch 日志
# 默认写入 http://127.0.0.1:9200 的按天索引 suck-api-logs-YYYY.MM.DD。
ES_ENABLED=true
ES_URL=http://127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=
# ES_API_KEY=              # 优先于用户名/密码
ES_INDEX=suck-api-logs
# ES_INDEX_DAILY=false       # 关闭按天索引
# ES_BATCH_SIZE=100
# ES_FLUSH_MS=5000
# ES_TIMEOUT_MS=5000
# ES_LOG_ALL_REQUESTS=true   # 连静态资源请求也记录（默认只记 /api）
